# ==============================================================================
# NEXUS AI — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure your keys
# NEVER commit your actual .env file with real secrets to GitHub!
# ==============================================================================

# 1. Google Gemini API Key (Required for live Gemini AI generation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Node.js + Express Backend Port (Default: 3001)
PORT=3001

# 3. Optional: Allowed CORS Origins (Comma-separated, default is *)
ALLOWED_ORIGINS=http://localhost:5173,https://tejasbargat16-ux.github.io

# 4. Optional: Frontend API URL (Only needed if backend is hosted on a separate domain)
# VITE_NEXUS_API_URL=https://your-nexus-api.onrender.com/api/chat
